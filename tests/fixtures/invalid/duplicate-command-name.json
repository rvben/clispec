  "commands": [
    {
      "name": "list",
      "description": "List services.",
      "effects": "read_only",
      "cardinality": "bounded",
      "stdout_schema": {}
    },
    {
      "name": "list",
      "description": "List services, again.",
      "effects": "read_only",
      "cardinality": "single",
      "stdout_schema": {}
    }
  ],
  "errors": [
    {
      "kind": "not_found",
      "exit_code": 4
    }
  ]
}
