  "x-test": {
    "violates": "unique-command-names",
    "detect": "rules",
    "at": "/commands/1",
    "why": "Two entries with the same path make the second unaddressable, and a consumer picking the first silently gets whichever contract was written down first."
  },
  "clispec": "0.3",
