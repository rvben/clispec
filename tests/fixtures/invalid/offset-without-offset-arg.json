{
  "x-test": {
    "violates": "pagination style offset requires offset_arg",
    "detect": "schema",
    "at": "/commands/0/pagination",
    "why": "The offset is the only thing a consumer advances in this style. A command that declares offset paging and accepts no offset returns page one forever, and the declaration reads as a capability the tool does not have."
  },
  "clispec": "0.3",
  "name": "mytool",
  "version": "1.0.0",
  "commands": [
    {
      "name": "list",
      "description": "List every event ever recorded.",
      "effects": "read_only",
      "cardinality": "unbounded",
      "stdout_schema": {},
      "pagination": {
        "style": "offset",
        "limit_arg": "--limit"
      },
      "fields_arg": "--fields",
      "args": [
        {
          "name": "--limit",
          "type": "integer"
        },
        {
          "name": "--fields",
          "type": "string[]"
        }
      ]
    }
  ],
  "errors": [
    {
      "kind": "not_found",
      "exit_code": 4
    }
  ]
}
